# ============================================================================
# Qwen3-TTS API Server Configuration
# ============================================================================
# Copy this file to `.env` and adjust values for your system.
# Every variable here is optional and has a safe default. Lines are grouped by
# concern. Boolean values accept: true/false, 1/0, yes/no, on/off (case-insensitive).
# Invalid values fall back to the documented default instead of crashing.

# ============================================================================
# Backend selection
# ============================================================================

# TTS backend implementation.
#   official   — Official Qwen3-TTS implementation (default; GPU/CPU auto-detect,
#                single model).
#   optimized  — GPU production backend with per-purpose model switching,
#                native real-time PCM streaming, torch.compile + CUDA graphs,
#                and the voice library. Reads its model roster from TTS_CONFIG.
TTS_BACKEND=official

# YAML config file for the *optimized* backend only (ignored by `official`).
# Defines default_model / voice_clone_model / load_both_models / models /
# optimization knobs. Default location: ~/qwen3-tts/config.yaml
# TTS_CONFIG=/path/to/config.yaml

# ============================================================================
# Model selection
# ============================================================================

# Model identifier (HF repo id or local path resolved against TTS_MODELS_DIR).
# Used by the *official* backend. (The *optimized* backend reads models from
# TTS_CONFIG instead.) Examples:
#   Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice  (default; best quality, no cloning)
#   Qwen/Qwen3-TTS-12Hz-1.7B-Base         (voice cloning support)
#   Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice  (smaller model, also CPU-friendly)
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# TTS_MODEL_NAME is a legacy alias for TTS_MODEL_ID — setting either has the
# same effect, but TTS_MODEL_ID takes precedence. Prefer TTS_MODEL_ID.
# TTS_MODEL_NAME=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice

# ============================================================================
# Device and precision (official backend)
# ============================================================================

# Device to run inference on.
#   auto       — GPU if available, otherwise CPU (default)
#   cpu        — Force CPU inference
#   cuda        — Use default GPU
#   cuda:0     — Use a specific GPU index
TTS_DEVICE=auto

# Data type for model weights and computation.
#   auto       — bfloat16 on GPU, float32 on CPU (default, recommended)
#   float32    — Full precision (recommended for CPU; stable, slower)
#   float16    — Half precision (GPU only; may be unstable on some models)
#   bfloat16   — BFloat16 (Ampere+ GPUs; best GPU option)
TTS_DTYPE=auto

# Attention implementation.
#   auto                — Try flash_attention_2, fall back to sdpa, then eager
#   flash_attention_2   — Fastest; requires Ampere+ GPU + flash-attn installed
#   sdpa                — PyTorch native scaled-dot-product attention (CPU/GPU)
#   eager               — Standard attention (slowest, most compatible)
TTS_ATTN=auto

# ============================================================================
# Server settings
# ============================================================================

# Network host to bind. Use 0.0.0.0 for all interfaces (default).
HOST=0.0.0.0

# API key for authenticating requests. When set (alone or together with
# UI_USER/UI_PASSWORD below), all routes EXCEPT /health require valid
# credentials. Clients may send the key via either:
#   Authorization: Bearer <key>
#   X-API-Key: <key>
# When unset and no UI credentials are configured, authentication is DISABLED
# (all routes are open) — the default for local/trusted deployments.
# WARNING: when binding HOST=0.0.0.0 on an untrusted network, set API_KEY to a
# strong random value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# API_KEY=change-me-to-a-long-random-secret

# Browser UI credentials (HTTP Basic auth). Set BOTH to let a human log in to
# the web UI (/ /docs /redoc /static/*) via the browser's native login dialog.
# Send as `Authorization: Basic <base64(user:password)>`. Independent of
# API_KEY: configure either, both, or neither. When both are set, browsers use
# Basic and API clients use Bearer/X-API-Key, each valid on its own.
# UI_USER=admin
# UI_PASSWORD=change-me

# TCP port for the API (1–65535). Default 8880.
PORT=8880

# Number of uvicorn worker processes (>=1). Default 1.
# WARNING: each worker loads its own full model copy and can exhaust VRAM;
# single-GPU deployments should normally use WORKERS=1.
WORKERS=1

# Concurrency cap for generation requests (>=1). Default 1.
# Serializes GPU work so multiple concurrent requests don't each allocate a KV
# cache and OOM. Raise only if you have enough VRAM for that many simultaneous
# generations.
TTS_MAX_CONCURRENT=1

# Logging level. One of: DEBUG | INFO | WARNING | ERROR | CRITICAL (case-insensitive).
# Default INFO.
LOG_LEVEL=INFO

# Allowed CORS origins, comma-separated. Use * for all (disables credentials
# for browser safety). Default *. Example: https://app.example.com,https://dev.example.com
CORS_ORIGINS=*

# ============================================================================
# Startup / lifecycle
# ============================================================================

# Lazy-load the model: defer the (slow) model load + warmup until the first
# synthesis request, instead of blocking server startup. Default true.
#   true  — load on first request (fast startup, slow first request)
#   false — load at startup (slow startup, fast first request)
TTS_LAZY_LOAD=true

# Run a warmup inference pass on startup/first-load so torch.compile kernels
# and cuDNN are pre-built before the first real request. Recommended for
# production. Default false.
#   true | false
TTS_WARMUP_ON_START=false

# Auto-shutdown the server after this many seconds with no successful speech
# request (after at least one speech request has been served). Read-only
# endpoints (/health, /models, /voices) do NOT reset the timer. 0 = never
# auto-shut down (default; suitable for a long-running server).
#   0 = disabled | positive integer (seconds)
TTS_IDLE_TIMEOUT_SECONDS=0

# Optional GPU keepalive: every N seconds, run a tiny matmul on the GPU to keep
# it from dropping to idle clock speeds between requests. 0 = disabled (default).
#   0 = disabled | positive integer (seconds)
GPU_KEEPALIVE_INTERVAL=0

# ============================================================================
# Input chunking (bounds peak VRAM for long inputs)
# ============================================================================
# Input text is split at punctuation into chunks sized to a [min, max] window,
# each synthesized separately so each chunk gets its own short-lived KV cache
# (freed before the next chunk). This keeps peak VRAM bounded by ONE chunk
# instead of the whole document. Short inputs that fit in one chunk take the
# original code path with zero overhead.

# Enable chunking for NON-STREAMING requests (/audio/speech without
# stream_format). Default true.
#   true | false
TTS_AUTOCHUNK=true

# Enable chunking for STREAMING requests (stream_format=audio|sse), independent
# of TTS_AUTOCHUNK. Bounds peak VRAM for long streaming text by giving each
# chunk its own short-lived KV cache. Set false to restore monolithic streaming
# (one unbounded KV cache for the whole input — risks OOM on very long text).
# Default true.
#   true | false
TTS_STREAM_AUTOCHUNK=true

# Soft minimum chunk length in characters (shared by both paths). Chunks
# shorter than this are merged into a neighbour if the result still fits.
# Must be >= 1. Default 20.
TTS_MIN_CHUNK_CHARS=20

# Target maximum chunk length in characters (shared by both paths). Hard upper
# bound per chunk. Must be >= TTS_MIN_CHUNK_CHARS. Default 70.
TTS_MAX_CHUNK_CHARS=70

# Silence inserted between generated chunks, in milliseconds (shared by both
# paths). 0 = no gap. Default 120.
TTS_CHUNK_GAP_MS=120

# Silence inserted at Markdown block boundaries (headings, paragraph breaks,
# lists) so they get a more pronounced pause than the regular inter-chunk gap
# above. 0 = no extra gap. Default 250.
TTS_PARAGRAPH_GAP_MS=250

# ============================================================================
# Voice library & custom voices
# ============================================================================

# Directory for saved voice library profiles (used via voice="clone:ProfileName").
# Default ./voice_library
VOICE_LIBRARY_DIR=./voice_library

# Directory of legacy/custom voice profiles loaded by the backend at startup.
# Default <repo>/custom_voices
# TTS_CUSTOM_VOICES=./custom_voices

# ============================================================================
# Voice Studio (optional web UI)
# ============================================================================

# Enable the Voice Studio Gradio web interface served by the API. Default false.
#   true | false
ENABLE_VOICE_STUDIO=false

# ============================================================================
# Local models folder (required for the official backend in containers)
# ============================================================================
# Path to a folder of pre-downloaded model snapshots, one subdir per model
# named after the HF repo WITHOUT the org prefix (e.g. Qwen3-TTS-12Hz-1.7B-Base).
# This build loads models ONLY from local paths — it does not use the
# HuggingFace cache and never downloads.
# In docker-compose.yml, bind-mount a host folder to /MODELS and set this to /MODELS.
TTS_MODELS_DIR=/MODELS

# ============================================================================
# Gradio Voice Studio client settings (only used by gradio_voice_studio.py)
# ============================================================================
# Base URL of the TTS API the standalone Voice Studio app talks to.
# Default http://localhost:8880
# TTS_BASE_URL=http://localhost:8880

# HTTP timeout (seconds) for the Voice Studio client. Default 300.
# TTS_TIMEOUT_S=300
